# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API Keys).

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Chave secreta (antiga service_role). Ignora a RLS: usar SOMENTE no servidor.
# Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# URL pública do site (sitemap, Open Graph, links de e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Conexão direta com o Postgres — usada só para aplicar migrations e gerar tipos
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require
