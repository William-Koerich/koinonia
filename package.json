{
  "name": "koinonia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:types": "bash -c 'set -a && source .env.local && supabase gen types typescript --db-url \"$DATABASE_URL\" --schema public > src/types/database.ts'",
